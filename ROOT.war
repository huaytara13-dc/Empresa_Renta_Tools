 y_``| òSELECT to_char(fecha,'YYYY-MM-DD') AS "D√≠a", COUNT(*) AS "Accesos exitosos" FROM registro_accesos WHERE evento = 'LOGIN_OK' AND  GROUP BY 1 ORDER BY 1~SELECT usuario AS "Usuario", COUNT(*) FILTER (WHERE evento='LOGIN_FALLIDO') AS "Intentos fallidos", COUNT(*) FILTER (WHERE evento='BLOQUEO') AS "Bloqueos" FROM registro_accesos WHERE evento IN ('LOGIN_FALLIDO','BLOQUEO') AND  GROUP BY usuario ORDER BY 2 DESCÄ nSELECT usuario AS "Usuario", COUNT(*) AS "Actividades" FROM auditoria WHERE  GROUP BY usuario ORDER BY 2 DESCÇ hSELECT modulo AS "M√≥dulo", COUNT(*) AS "Cambios" FROM auditoria WHERE  GROUP BY modulo ORDER BY 2 DESCÑ'SELECT c.nombres || ' ' || c.apellidos AS "Cliente", COUNT(a.id) AS "Alquileres", COALESCE(SUM((a.subtotal + a.igv)),0) AS "Monto S/" FROM alquileres a JOIN clientes c ON c.id = a.cliente_id WHERE a.estado <> 'ANULADO' AND  GROUP BY c.id, c.nombres, c.apellidos ORDER BY 2 DESC, 3 DESC LIMIT 10ÜSELECT c.nombres || ' ' || c.apellidos AS "Cliente", COALESCE(SUM((a.subtotal + a.igv)),0) AS "Monto S/", COUNT(a.id) AS "Alquileres" FROM alquileres a JOIN clientes c ON c.id = a.cliente_id WHERE a.estado <> 'ANULADO' AND  GROUP BY c.id, c.nombres, c.apellidos ORDER BY 2 DESC LIMIT 10ààSELECT c.nombres || ' ' || c.apellidos AS "Cliente", COUNT(a.id) AS "Alquileres", COALESCE(SUM((a.subtotal + a.igv)),0) AS "Total S/", ROUND(COALESCE(AVG((a.subtotal + a.igv)),0),2) AS "Promedio S/", MAX(a.fecha_inicio) AS "√öltimo alquiler" FROM clientes c LEFT JOIN alquileres a ON a.cliente_id = c.id AND a.estado <> 'ANULADO' AND  GROUP BY c.id, c.nombres, c.apellidos ORDER BY 2 DESC, 1äLSELECT e.codigo || ' - ' || e.nombre AS "Equipo", COUNT(d.id) AS "Veces alquilado", COALESCE(SUM(d.dias),0) AS "D√≠as alquilado" FROM equipos e JOIN detalle_alquiler d ON d.equipo_id = e.id JOIN alquileres a ON a.id = d.alquiler_id WHERE a.estado <> 'ANULADO' AND  GROUP BY e.id, e.codigo, e.nombre ORDER BY 2 DESC, 3 DESC LIMIT 10å9SELECT e.codigo || ' - ' || e.nombre AS "Equipo", COUNT(a.id) AS "Veces alquilado" FROM equipos e LEFT JOIN detalle_alquiler d ON d.equipo_id = e.id LEFT JOIN alquileres a ON a.id = d.alquiler_id AND a.estado <> 'ANULADO' AND  WHERE e.estado <> 'BAJA' GROUP BY e.id, e.codigo, e.nombre ORDER BY 2 ASC, 1 LIMIT 10éDSELECT e.codigo || ' - ' || e.nombre AS "Equipo", COALESCE(SUM(d.subtotal),0) AS "Ingresos S/", COUNT(d.id) AS "Veces alquilado" FROM equipos e JOIN detalle_alquiler d ON d.equipo_id = e.id JOIN alquileres a ON a.id = d.alquiler_id WHERE a.estado <> 'ANULADO' AND  GROUP BY e.id, e.codigo, e.nombre ORDER BY 2 DESC LIMIT 15ê ¿SELECT to_char(a.fecha_creacion,'YYYY-MM') AS "Mes", COUNT(*) AS "Alquileres", SUM((a.subtotal + a.igv)) AS "Monto S/" FROM alquileres a WHERE a.estado <> 'ANULADO' AND  GROUP BY 1 ORDER BY 1í ƒSELECT to_char(a.fecha_creacion,'YYYY-MM-DD') AS "D√≠a", COUNT(*) AS "Alquileres", SUM((a.subtotal + a.igv)) AS "Monto S/" FROM alquileres a WHERE a.estado <> 'ANULADO' AND  GROUP BY 1 ORDER BY 1î „SELECT to_char(date_trunc('week', a.fecha_creacion),'YYYY-MM-DD') AS "Semana (inicio)", COUNT(*) AS "Alquileres", SUM((a.subtotal + a.igv)) AS "Monto S/" FROM alquileres a WHERE a.estado <> 'ANULADO' AND  GROUP BY 1 ORDER BY 1ñ æSELECT to_char(a.fecha_creacion,'YYYY') AS "A√±o", COUNT(*) AS "Alquileres", SUM((a.subtotal + a.igv)) AS "Monto S/" FROM alquileres a WHERE a.estado <> 'ANULADO' AND  GROUP BY 1 ORDER BY 1ò ·SELECT u.usuario AS "Usuario", COUNT(a.id) AS "Alquileres", SUM((a.subtotal + a.igv)) AS "Monto S/" FROM alquileres a JOIN usuarios u ON u.id = a.usuario_id WHERE a.estado <> 'ANULADO' AND  GROUP BY u.usuario ORDER BY 2 DESCö0SELECT COALESCE(NULLIF(e.categoria,''),'Sin categor√≠a') AS "Categor√≠a", SUM(d.subtotal) AS "Ingresos S/", COUNT(d.id) AS "Veces alquilado" FROM detalle_alquiler d JOIN equipos e ON e.id = d.equipo_id JOIN alquileres a ON a.id = d.alquiler_id WHERE a.estado <> 'ANULADO' AND  GROUP BY 1 ORDER BY 2 DESCú ìSELECT a.estado AS "Estado", COUNT(*) AS "Alquileres", SUM(a.total) AS "Monto total S/" FROM alquileres a WHERE  GROUP BY a.estado ORDER BY 2 DESCû SELECT m.mes AS "Mes", ROUND(m.alq + COALESCE(p.pen,0),2) AS "Ingreso total S/", m.alq AS "Por alquileres S/", COALESCE(p.pen,0) AS "Por penalidades S/" FROM (SELECT to_char(a.fecha_creacion,'YYYY-MM') AS mes, SUM((a.subtotal + a.igv)) AS alq FROM alquileres a WHERE a.estado <> 'ANULADO' AND  GROUP BY 1) m LEFT JOIN (SELECT to_char(fecha_devolucion,'YYYY-MM') AS mes, SUM(penalidad_total) AS pen FROM devoluciones GROUP BY 1) p ON p.mes = m.mes ORDER BY 1† ”SELECT to_char(a.fecha_creacion,'YYYY-MM') AS "Mes", ROUND(AVG((a.subtotal + a.igv)),2) AS "Ticket promedio S/", COUNT(*) AS "Alquileres" FROM alquileres a WHERE a.estado <> 'ANULADO' AND  GROUP BY 1 ORDER BY 1¢SELECT mes AS "Mes", SUM(monto) OVER (ORDER BY mes) AS "Ingreso acumulado S/", monto AS "Ingreso del mes S/" FROM (SELECT to_char(a.fecha_creacion,'YYYY-MM') AS mes, SUM((a.subtotal + a.igv)) AS monto FROM alquileres a WHERE a.estado <> 'ANULADO' AND  GROUP BY 1) t ORDER BY 1§ öSELECT tipo AS "Tipo", COUNT(*) AS "Comprobantes", SUM(total) AS "Monto S/" FROM comprobantes WHERE estado = 'EMITIDO' AND  GROUP BY tipo ORDER BY 2 DESC¶ õSELECT tipo AS "Tipo de incidencia", COUNT(*) AS "Incidencias", COALESCE(SUM(monto),0) AS "Monto S/" FROM incidencias WHERE  GROUP BY tipo ORDER BY 2 DESC® SELECT to_char(fecha_devolucion,'YYYY-MM') AS "Mes", COUNT(*) FILTER (WHERE dias_retraso > 0) AS "Con retraso", COUNT(*) AS "Devoluciones", COALESCE(SUM(penalidad_total),0) AS "Penalidades S/" FROM devoluciones WHERE  GROUP BY 1 ORDER BY 1 InnerClasses ´ %java/lang/invoke/MethodHandles$Lookup ≠ java/lang/invoke/MethodHandles Lookup 1      67 8    H 97 8     :7 8    ∞ ;7 8    ƒ <7 8    Ì =7 8   ! >7 8   ?  	 
