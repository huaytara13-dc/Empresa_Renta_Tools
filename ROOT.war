PK
    oÇ{] Ôﬂ       WEB-INF/vistas/comprobantes.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.math.BigDecimal"%>
<%@page import="java.util.List"%>
<%@page import="com.rentatools.model.Comprobante"%>
<%@page import="com.rentatools.service.ComprobanteService"%>
<% String tituloPagina = "Comprobantes"; String menuActivo = "comprobantes"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    @SuppressWarnings("unchecked")
    List<Comprobante> comprobantes = (List<Comprobante>) request.getAttribute("comprobantes");
    String flashTipo = (String) request.getAttribute("flashTipo");
    String flashMensaje = (String) request.getAttribute("flashMensaje");
    @SuppressWarnings("unchecked")
    java.util.Map<String, java.math.BigDecimal> ind = (java.util.Map<String, java.math.BigDecimal>) request.getAttribute("ind");
    String busqueda = ((com.rentatools.model.Pagina<?>) request.getAttribute("pag")).getQ();
    int emitidos = ind.get("emitidos").intValue();
    int boletas = ind.get("boletas").intValue();
    int facturas = ind.get("facturas").intValue();
    BigDecimal facturado = ind.get("facturado");
%>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Comprobantes de pago</h1>
    <p class="text-secondary mb-0">Boletas y facturas de los alquileres. Se emiten autom√°ticamente al registrar cada alquiler.</p>
</div>

<% if (flashMensaje != null) { %>
<div class="alert alert-<%= Html.esc(flashTipo) %> alert-dismissible fade show" role="alert">
    <%= Html.esc(flashMensaje) %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi p-3"><div class="titulo">Comprobantes emitidos</div><div class="valor"><%= emitidos %></div></div></div>
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi naranja p-3"><div class="titulo">Boletas</div><div class="valor"><%= boletas %></div></div></div>
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi p-3"><div class="titulo">Facturas</div><div class="valor"><%= facturas %></div></div></div>
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi verde p-3"><div class="titulo">Total facturado</div><div class="valor fs-2">S/ <%= facturado.toPlainString() %></div></div></div>
</div>

<section class="card p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h2 class="h5 fw-bold mb-0">Lista de comprobantes</h2>
        <form method="get" action="<%= ctx %>/comprobantes" class="d-flex gap-2">
            <input type="text" name="q" value="<%= Html.esc(busqueda) %>" class="form-control" style="max-width: 280px"
                   placeholder="Buscar comprobante‚Ä¶" aria-label="Buscar comprobante">
            <button class="btn btn-outline-primary" type="submit">Buscar</button>
            <% if (!busqueda.isEmpty()) { %><a class="btn btn-link" href="<%= ctx %>/comprobantes">Limpiar</a><% } %>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table tabla align-middle" id="tablaComprobantes">
            <thead>
                <tr><th>N√∫mero</th><th>Tipo</th><th>Fecha</th><th>Cliente</th><th>Alquiler</th><th>Total</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
            <% for (Comprobante co : comprobantes) { %>
                <tr>
                    <td class="fw-semibold text-nowrap"><%= co.getNumeroCompleto() %></td>
                    <td><%= Html.esc(ComprobanteService.etiquetaTipo(co.getTipo())) %></td>
                    <td class="text-nowrap"><%= co.getFechaEmision() %></td>
                    <td><%= Html.esc(co.getClienteNombre()) %>
                        <div class="text-secondary small"><%= Html.esc(co.getClienteDocumento()) %></div></td>
                    <td><a class="text-decoration-none" href="<%= ctx %>/alquileres?accion=ver&amp;id=<%= co.getAlquilerId() %>">N.¬∫ <%= co.getAlquilerId() %></a></td>
                    <td class="text-nowrap">S/ <%= co.getTotal().toPlainString() %></td>
                    <td><span class="badge <%= "EMITIDO".equals(co.getEstado()) ? "text-bg-success" : "text-bg-secondary" %>"><%= "EMITIDO".equals(co.getEstado()) ? "Emitido" : "Anulado" %></span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="<%= ctx %>/comprobantes?accion=ver&amp;id=<%= co.getId() %>">Ver</a></td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <% if (comprobantes.isEmpty()) { %><p class="text-secondary mb-0"><%= busqueda.isEmpty() ? "A√∫n no hay comprobantes emitidos." : "No se encontraron resultados para la b√∫squeda." %></p><% } %>
    <%@ include file="fragmentos/paginacion.jspf" %>
</section>

<script>
</script>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]î∫‚  ‚  %   WEB-INF/vistas/devolucion-detalle.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="com.rentatools.model.DetalleDevolucion"%>
<%@page import="com.rentatools.model.Devolucion"%>
<%@page import="com.rentatools.model.Incidencia"%>
<%@page import="com.rentatools.service.DevolucionService"%>
<%@page import="com.rentatools.service.EquipoService"%>
<% String tituloPagina = "Devoluci√≥n"; String menuActivo = "devoluciones"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    Devolucion dv = (Devolucion) request.getAttribute("devolucion");
    String flashTipo = (String) request.getAttribute("flashTipo");
    String flashMensaje = (String) request.getAttribute("flashMensaje");
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Devoluci√≥n N.¬∫ <%= dv.getId() %></h1>
        <p class="text-secondary mb-0">Recibida por <%= Html.esc(dv.getUsuarioNombre()) %></p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="<%= ctx %>/devoluciones">Volver a la lista</a>
        <a class="btn btn-outline-primary" href="<%= ctx %>/alquileres?accion=ver&amp;id=<%= dv.getAlquilerId() %>">Ver alquiler N.¬∫ <%= dv.getAlquilerId() %></a>
    </div>
</div>

<% if (flashMensaje != null) { %>
<div class="alert alert-<%= Html.esc(flashTipo) %> alert-dismissible fade show" role="alert">
    <%= Html.esc(flashMensaje) %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>

<% if (dv.getMontoAdicional().signum() > 0) { %>
<div class="alert alert-danger" role="alert">
    Las penalidades superan la garant√≠a: se debe cobrar al cliente <strong>S/ <%= dv.getMontoAdicional().toPlainString() %></strong> adicionales.
</div>
<% } %>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <section class="card p-4 mb-3">
            <h2 class="h5 fw-bold mb-3">Datos de la devoluci√≥n</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-normal text-secondary">Cliente</dt>
                <dd class="col-sm-8"><%= Html.esc(dv.getClienteNombre()) %></dd>
                <dt class="col-sm-4 fw-normal text-secondary">Fecha de devoluci√≥n</dt>
                <dd class="col-sm-8"><%= dv.getFechaDevolucion() %></dd>
                <dt class="col-sm-4 fw-normal text-secondary">Retraso</dt>
                <dd class="col-sm-8"><%= dv.getDiasRetraso() > 0 ? dv.getDiasRetraso() + (dv.getDiasRetraso() == 1 ? " d√≠a" : " d√≠as") : "Devuelto a tiempo" %></dd>
                <dt class="col-sm-4 fw-normal text-secondary">Observaciones</dt>
                <dd class="col-sm-8 mb-0"><%= dv.getObservaciones().isEmpty() ? "‚Äî" : Html.esc(dv.getObservaciones()) %></dd>
            </dl>
        </section>

        <section class="card p-4 mb-3">
            <h2 class="h5 fw-bold mb-3">Equipos recibidos</h2>
            <div class="table-responsive">
                <table class="table tabla align-middle mb-0">
                    <thead><tr><th>C√≥digo</th><th>Equipo</th><th>Qued√≥</th></tr></thead>
                    <tbody>
                    <% for (DetalleDevolucion d : dv.getDetalles()) {
                           String est = d.getEstadoEquipo();
                           String claseEst = "DISPONIBLE".equals(est) ? "text-bg-success"
                                   : "MANTENIMIENTO".equals(est) ? "text-bg-warning"
                                   : "INCIDENCIA".equals(est) ? "text-bg-danger" : "text-bg-secondary";
                    %>
                        <tr>
                            <td class="fw-semibold"><%= Html.esc(d.getEquipoCodigo()) %></td>
                            <td><%= Html.esc(d.getEquipoNombre()) %></td>
                            <td><span class="badge <%= claseEst %>"><%= Html.esc(EquipoService.etiquetaEstado(est)) %></span></td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card p-4">
            <h2 class="h5 fw-bold mb-3">Incidencias</h2>
            <% if (dv.getIncidencias().isEmpty()) { %>
            <p class="text-secondary mb-0">No se registraron incidencias.</p>
            <% } else { %>
            <div class="table-responsive">
                <table class="table tabla align-middle mb-0">
                    <thead><tr><th>Equipo</th><th>Tipo</th><th>Descripci√≥n</th><th class="text-end">Monto</th></tr></thead>
                    <tbody>
                    <% for (Incidencia inc : dv.getIncidencias()) { %>
                        <tr>
                            <td class="fw-semibold"><%= Html.esc(inc.getEquipoCodigo()) %></td>
                            <td><span class="badge text-bg-light border"><%= Html.esc(DevolucionService.etiquetaTipo(inc.getTipo())) %></span></td>
                            <td><%= Html.esc(inc.getDescripcion()) %></td>
                            <td class="text-end text-nowrap">S/ <%= inc.getMonto().toPlainString() %></td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="card p-4">
            <h2 class="h5 fw-bold mb-3">Liquidaci√≥n</h2>
            <dl class="row mb-0">
                <dt class="col-7 fw-normal text-secondary">Penalidad por retraso</dt><dd class="col-5 text-end">S/ <%= dv.getPenalidadRetraso().toPlainString() %></dd>
                <dt class="col-7 fw-normal text-secondary">Penalidad por incidencias</dt><dd class="col-5 text-end">S/ <%= dv.getPenalidadIncidencias().toPlainString() %></dd>
                <dt class="col-7">Penalidad total</dt><dd class="col-5 text-end fw-bold">S/ <%= dv.getPenalidadTotal().toPlainString() %></dd>
                <dt class="col-7">Garant√≠a devuelta</dt><dd class="col-5 text-end fw-bold text-success">S/ <%= dv.getGarantiaDevuelta().toPlainString() %></dd>
                <dt class="col-7">Cobro adicional</dt><dd class="col-5 text-end fw-bold <%= dv.getMontoAdicional().signum() > 0 ? "text-danger" : "" %>">S/ <%= dv.getMontoAdicional().toPlainString() %></dd>
            </dl>
        </section>
    </div>
</div>

