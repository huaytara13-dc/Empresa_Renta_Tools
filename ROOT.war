    oÇ{]ó1¢ˆî  î  !   WEB-INF/vistas/proveedor-form.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.util.List"%>
<%@page import="com.rentatools.model.Proveedor"%>
<%@page import="com.rentatools.service.ProveedorService"%>
<% String tituloPagina = "Proveedor"; String menuActivo = "proveedores"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    Proveedor f = (Proveedor) request.getAttribute("proveedorForm");
    boolean editar = "editar".equals(request.getAttribute("modo"));
    @SuppressWarnings("unchecked")
    List<String> errores = (List<String>) request.getAttribute("errores");
    String csrf = (String) request.getAttribute("csrf");
%>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1"><%= editar ? "Editar proveedor" : "Nuevo proveedor" %></h1>
    <p class="text-secondary mb-0">Los campos con * son obligatorios.</p>
</div>

<% if (errores != null && !errores.isEmpty()) { %>
<div class="alert alert-danger" role="alert">
    <ul class="mb-0">
        <% for (String err : errores) { %><li><%= Html.esc(err) %></li><% } %>
    </ul>
</div>
<% } %>

<form method="post" action="<%= ctx %>/proveedores" class="card p-4" novalidate>
    <input type="hidden" name="accion" value="<%= editar ? "actualizar" : "crear" %>">
    <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
    <% if (editar) { %><input type="hidden" name="id" value="<%= f.getId() %>"><% } %>

    <div class="row g-3">
        <div class="col-md-4">
            <label for="ruc" class="form-label fw-semibold">RUC *</label>
            <input type="text" id="ruc" name="ruc" class="form-control" maxlength="11" inputmode="numeric"
                   autocomplete="off" required value="<%= Html.esc(f.getRuc()) %>">
            <div class="form-text">11 d√≠gitos.</div>
        </div>
        <div class="col-md-8">
            <label for="razonSocial" class="form-label fw-semibold">Raz√≥n social *</label>
            <input type="text" id="razonSocial" name="razonSocial" class="form-control" maxlength="150" required
                   value="<%= Html.esc(f.getRazonSocial()) %>">
        </div>
        <div class="col-md-6">
            <label for="rubro" class="form-label fw-semibold">Rubro *</label>
            <select id="rubro" name="rubro" class="form-select">
                <option value="">Seleccione‚Ä¶</option>
                <% for (String rb : ProveedorService.RUBROS) { %>
                <option value="<%= Html.esc(rb) %>" <%= rb.equals(f.getRubro()) ? "selected" : "" %>><%= Html.esc(rb) %></option>
                <% } %>
            </select>
        </div>
        <div class="col-md-6">
            <label for="contacto" class="form-label fw-semibold">Persona de contacto</label>
            <input type="text" id="contacto" name="contacto" class="form-control" maxlength="100"
                   value="<%= Html.esc(f.getContacto()) %>">
        </div>
        <div class="col-md-6">
            <label for="telefono" class="form-label fw-semibold">Tel√©fono</label>
            <input type="text" id="telefono" name="telefono" class="form-control" maxlength="20"
                   value="<%= Html.esc(f.getTelefono()) %>">
        </div>
        <div class="col-md-6">
            <label for="correo" class="form-label fw-semibold">Correo electr√≥nico</label>
            <input type="email" id="correo" name="correo" class="form-control" maxlength="120"
                   value="<%= Html.esc(f.getCorreo()) %>">
        </div>
        <div class="col-md-8">
            <label for="direccion" class="form-label fw-semibold">Direcci√≥n</label>
            <input type="text" id="direccion" name="direccion" class="form-control" maxlength="200"
                   value="<%= Html.esc(f.getDireccion()) %>">
        </div>
        <div class="col-md-4">
            <label for="estado" class="form-label fw-semibold">Estado *</label>
            <select id="estado" name="estado" class="form-select">
                <option value="ACTIVO" <%= "ACTIVO".equals(f.getEstado()) ? "selected" : "" %>>Activo</option>
                <option value="INACTIVO" <%= "INACTIVO".equals(f.getEstado()) ? "selected" : "" %>>Inactivo</option>
            </select>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-naranja px-4"><%= editar ? "Guardar cambios" : "Registrar proveedor" %></button>
        <a class="btn btn-outline-primary" href="<%= ctx %>/proveedores">Cancelar</a>
    </div>
</form>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]ûÎ
ﬂi  i     WEB-INF/vistas/proveedores.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.util.List"%>
<%@page import="com.rentatools.model.Proveedor"%>
<% String tituloPagina = "Proveedores"; String menuActivo = "proveedores"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    @SuppressWarnings("unchecked")
    List<Proveedor> proveedores = (List<Proveedor>) request.getAttribute("proveedores");
    String csrf = (String) request.getAttribute("csrf");
    String flashTipo = (String) request.getAttribute("flashTipo");
    String flashMensaje = (String) request.getAttribute("flashMensaje");
    @SuppressWarnings("unchecked")
    java.util.Map<String, Integer> conteos = (java.util.Map<String, Integer>) request.getAttribute("conteos");
    int total = 0;
    for (int n : conteos.values()) total += n;
    String busqueda = ((com.rentatools.model.Pagina<?>) request.getAttribute("pag")).getQ();
    int activos = conteos.getOrDefault("ACTIVO", 0);
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Proveedores</h1>
        <p class="text-secondary mb-0">Proveedores de equipos, repuestos, accesorios y servicios.</p>
    </div>
    <a class="btn btn-naranja px-4 py-2" href="<%= ctx %>/proveedores?accion=nuevo">+ Nuevo proveedor</a>
</div>

<% if (flashMensaje != null) { %>
<div class="alert alert-<%= Html.esc(flashTipo) %> alert-dismissible fade show" role="alert">
    <%= Html.esc(flashMensaje) %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4"><div class="card kpi p-3"><div class="titulo">Proveedores registrados</div><div class="valor"><%= total %></div></div></div>
    <div class="col-12 col-md-4"><div class="card kpi verde p-3"><div class="titulo">Activos</div><div class="valor"><%= activos %></div></div></div>
    <div class="col-12 col-md-4"><div class="card kpi naranja p-3"><div class="titulo">Inactivos</div><div class="valor"><%= total - activos %></div></div></div>
</div>

<section class="card p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h2 class="h5 fw-bold mb-0">Lista de proveedores</h2>
        <form method="get" action="<%= ctx %>/proveedores" class="d-flex gap-2">
            <input type="text" name="q" value="<%= Html.esc(busqueda) %>" class="form-control" style="max-width: 280px"
                   placeholder="Buscar proveedor‚Ä¶" aria-label="Buscar proveedor">
            <button class="btn btn-outline-primary" type="submit">Buscar</button>
            <% if (!busqueda.isEmpty()) { %><a class="btn btn-link" href="<%= ctx %>/proveedores">Limpiar</a><% } %>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table tabla align-middle" id="tablaProveedores">
            <thead>
                <tr>
                    <th>RUC</th><th>Raz√≥n social</th><th>Rubro</th><th>Tel√©fono</th><th>Correo</th><th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            <% for (Proveedor pv : proveedores) {
                   String claseEstado = "ACTIVO".equals(pv.getEstado()) ? "text-bg-success" : "text-bg-secondary";
            %>
                <tr>
                    <td class="fw-semibold text-nowrap"><%= Html.esc(pv.getRuc()) %></td>
                    <td><%= Html.esc(pv.getRazonSocial()) %>
                        <% if (!pv.getContacto().isEmpty()) { %><div class="text-secondary small">Contacto: <%= Html.esc(pv.getContacto()) %></div><% } %></td>
                    <td><%= Html.esc(pv.getRubro()) %></td>
                    <td class="text-nowrap"><%= Html.esc(pv.getTelefono()) %></td>
                    <td><%= Html.esc(pv.getCorreo()) %></td>
                    <td><span class="badge <%= claseEstado %>"><%= Html.esc(pv.getEstado()) %></span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary"
                           href="<%= ctx %>/proveedores?accion=editar&amp;id=<%= pv.getId() %>">Editar</a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                data-id="<%= pv.getId() %>"
                                data-nombre="<%= Html.esc(pv.getRazonSocial()) %>">Eliminar</button>
                    </td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <% if (proveedores.isEmpty()) { %><p class="text-secondary mb-0"><%= busqueda.isEmpty() ? "A√∫n no hay proveedores registrados." : "No se encontraron resultados para la b√∫squeda." %></p><% } %>
    <%@ include file="fragmentos/paginacion.jspf" %>
</section>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="tituloEliminar" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" action="<%= ctx %>/proveedores" class="modal-content">
            <input type="hidden" name="accion" value="eliminar">
            <input type="hidden" name="id" id="idEliminar">
            <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
            <div class="modal-header">
                <h2 class="modal-title h5" id="tituloEliminar">Eliminar proveedor</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¬øSeguro que desea eliminar al proveedor <strong id="nombreEliminar"></strong>?
                Esta acci√≥n no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Eliminar</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (ev) {
        var b = ev.relatedTarget;
        document.getElementById('idEliminar').value = b.getAttribute('data-id');
        document.getElementById('nombreEliminar').textContent = b.getAttribute('data-nombre');
    });
</script>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]W jd≥  ≥     WEB-INF/vistas/reportes.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.util.List"%>
<%@page import="java.util.Map"%>
<%@page import="com.rentatools.model.ReporteDef"%>
<%@page import="com.rentatools.model.ResultadoReporte"%>
<% String tituloPagina = "Reportes"; String menuActivo = "reportes"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    @SuppressWarnings("unchecked")
    Map<String, List<ReporteDef>> catalogo = (Map<String, List<ReporteDef>>) request.getAttribute("catalogo");
    ReporteDef def = (ReporteDef) request.getAttribute("def");
    ResultadoReporte datos = (ResultadoReporte) request.getAttribute("datos");
    String desde = (String) request.getAttribute("desde");
    String hasta = (String) request.getAttribute("hasta");
    String json = (String) request.getAttribute("json");
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Reportes</h1>
        <p class="text-secondary mb-0">Gr&aacute;ficos con Apache ECharts y descarga de los datos en Excel.</p>
    </div>
    <% if (def != null) { %>
    <a class="btn btn-outline-primary" href="<%= ctx %>/reportes">&larr; Todos los reportes</a>
    <% } %>
</div>

<% if (def == null) { %>

    <% for (Map.Entry<String, List<ReporteDef>> area : catalogo.entrySet()) { %>
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-3"><%= Html.esc(area.getKey()) %></h2>
            <div class="row g-2">
                <% for (ReporteDef r : area.getValue()) { %>
                <div class="col-md-6 col-xl-4">
                    <a class="d-block border rounded-3 p-3 text-decoration-none h-100"
                       href="<%= ctx %>/reportes?id=<%= Html.esc(r.getId()) %>">
                        <span class="badge text-bg-primary me-2"><%= Html.esc(r.getId()) %></span>
                        <span class="text-dark"><%= Html.esc(r.getTitulo()) %></span>
                    </a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    <% } %>

<% } else { %>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="badge text-bg-primary mb-2"><%= Html.esc(def.getArea()) %> &middot; <%= Html.esc(def.getId()) %></span>
                    <h2 class="h4 fw-bold mb-0"><%= Html.esc(def.getTitulo()) %></h2>
                </div>
                <a class="btn btn-naranja px-4"
                   href="<%= ctx %>/reportes?id=<%= Html.esc(def.getId()) %>&formato=excel&desde=<%= Html.esc(desde) %>&hasta=<%= Html.esc(hasta) %>">
                    Descargar Excel</a>
            </div>

            <% if (def.isUsaFechas()) { %>
            <form class="row g-2 align-items-end mt-3" method="get" action="<%= ctx %>/reportes">
                <input type="hidden" name="id" value="<%= Html.esc(def.getId()) %>">
                <div class="col-auto">
                    <label class="form-label small mb-1" for="desde">Desde</label>
                    <input class="form-control" type="date" id="desde" name="desde" value="<%= Html.esc(desde) %>">
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-1" for="hasta">Hasta</label>
                    <input class="form-control" type="date" id="hasta" name="hasta" value="<%= Html.esc(hasta) %>">
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-primary" type="submit">Filtrar</button>
                    <a class="btn btn-link" href="<%= ctx %>/reportes?id=<%= Html.esc(def.getId()) %>">Quitar filtro</a>
                </div>
            </form>
            <% } %>
        </div>
    </div>

    <% if (datos.getFilas().isEmpty()) { %>
    <div class="alert alert-info">No hay datos para este reporte con los filtros elegidos.</div>
    <% } else { %>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div id="grafico" style="width:100%;height:380px"></div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle tabla mb-0">
                <thead>
                    <tr>
                        <% for (String c : datos.getColumnas()) { %><th><%= Html.esc(c) %></th><% } %>
                    </tr>
                </thead>
                <tbody>
                    <% for (List<Object> fila : datos.getFilas()) { %>
                    <tr>
                        <% for (Object v : fila) { %><td><%= v == null ? "" : Html.esc(v.toString()) %></td><% } %>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script type="application/json" id="datosReporte"><%= json %></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
    <script>
        (function () {
            var d = JSON.parse(document.getElementById('datosReporte').textContent);
            var tipo = '<%= Html.esc(def.getGrafico()) %>';
            var colores = ['#1F5FBF', '#F28C28', '#146C3A', '#8E44AD', '#C0392B', '#16A085', '#7F8C8D', '#D4AC0D'];
            var graf = echarts.init(document.getElementById('grafico'));
            var nombre = d.columnas.length > 1 ? d.columnas[1] : 'Valor';
            var opcion;
            if (tipo === 'pie') {
                opcion = {
                    color: colores,
                    tooltip: { trigger: 'item', formatter: '{b}: {c} ({d}%)' },
                    legend: { bottom: 0 },
                    series: [{ name: nombre, type: 'pie', radius: ['35%', '65%'],
                        data: d.etiquetas.map(function (e, i) { return { name: e, value: d.valores[i] }; }) }]
                };
            } else {
                opcion = {
                    color: colores,
                    tooltip: { trigger: 'axis' },
                    grid: { left: 50, right: 20, top: 40, bottom: 70 },
                    xAxis: { type: 'category', data: d.etiquetas, axisLabel: { rotate: d.etiquetas.length > 8 ? 35 : 0 } },
                    yAxis: { type: 'value', name: nombre },
                    series: [{ name: nombre, type: tipo, data: d.valores, smooth: tipo === 'line',
                        label: { show: d.etiquetas.length <= 12, position: 'top' } }]
                };
            }
            graf.setOption(opcion);
            window.addEventListener('resize', function () { graf.resize(); });
        })();
    </script>

    <% } %>
<% } %>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]@ü—0^   ^   $   WEB-INF/vistas/solicitud-detalle.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="com.rentatools.model.DetalleSolicitud"%>
<%@page import="com.rentatools.model.Solicitud"%>
<%@page import="com.rentatools.service.EquipoService"%>
<%@page import="com.rentatools.service.SolicitudService"%>
<% String tituloPagina = "Solicitud de alquiler"; String menuActivo = "solicitudes"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    Solicitud so = (Solicitud) request.getAttribute("solicitud");
    String csrf = (String) request.getAttribute("csrf");
    String flashTipo = (String) request.getAttribute("flashTipo");
    String flashMensaje = (String) request.getAttribute("flashMensaje");
    String st = so.getEstado();
    boolean pendiente = "PENDIENTE".equals(st);
    boolean aprobada = "APROBADA".equals(st);
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Solicitud N.¬∫ <%= so.getId() %>
            <span class="badge fs-6 align-middle <%= SolicitudService.claseEstado(st) %>"><%= Html.esc(SolicitudService.etiquetaEstado(st)) %></span></h1>
        <p class="text-secondary mb-0">Registrada por <%= Html.esc(so.getUsuarioNombre()) %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" href="<%= ctx %>/solicitudes">Volver a la lista</a>
        <% if (pendiente) { %>
        <a class="btn btn-outline-primary" href="<%= ctx %>/solicitudes?accion=editar&amp;id=<%= so.getId() %>">Editar</a>
        <% } %>
        <% if (aprobada) { %>
        <form method="post" action="<%= ctx %>/solicitudes" class="d-inline"
              onsubmit="return confirm('¬øConvertir esta solicitud en alquiler? Los equipos quedar√°n como alquilados.');">
            <input type="hidden" name="accion" value="convertir">
            <input type="hidden" name="id" value="<%= so.getId() %>">
            <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
            <button type="submit" class="btn btn-naranja">Convertir en alquiler</button>
        </form>
        <% } %>
        <% if (so.getAlquilerId() > 0) { %>
        <a class="btn btn-naranja" href="<%= ctx %>/alquileres?accion=ver&amp;id=<%= so.getAlquilerId() %>">Ver alquiler N.¬∫ <%= so.getAlquilerId() %></a>
        <% } %>
    </div>
</div>

<% if (flashMensaje != null) { %>
<div class="alert alert-<%= Html.esc(flashTipo) %> alert-dismissible fade show" role="alert">
    <%= Html.esc(flashMensaje) %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>

<% if (esAdmin && pendiente) { %>
<div class="card p-3 mb-3 border-warning">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <strong class="me-2">Decisi√≥n del administrador:</strong>
        <form method="post" action="<%= ctx %>/solicitudes" class="d-inline">
            <input type="hidden" name="accion" value="aprobar">
            <input type="hidden" name="id" value="<%= so.getId() %>">
            <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
            <button type="submit" class="btn btn-success btn-sm">Aprobar</button>
        </form>
        <form method="post" action="<%= ctx %>/solicitudes" class="d-inline"
              onsubmit="return confirm('¬øRechazar esta solicitud?');">
            <input type="hidden" name="accion" value="rechazar">
            <input type="hidden" name="id" value="<%= so.getId() %>">
            <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
            <button type="submit" class="btn btn-outline-danger btn-sm">Rechazar</button>
        </form>
    </div>
</div>
<% } %>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <section class="card p-4 mb-3">
            <h2 class="h5 fw-bold mb-3">Datos de la solicitud</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-normal text-secondary">Cliente</dt>
                <dd class="col-sm-8"><%= Html.esc(so.getClienteNombre()) %> ¬∑ <%= Html.esc(so.getClienteDocumento()) %></dd>
                <dt class="col-sm-4 fw-normal text-secondary">Fecha de registro</dt>
                <dd class="col-sm-8"><%= so.getFechaCreacion() != null ? so.getFechaCreacion().toLocalDate() : "" %></dd>
                <dt class="col-sm-4 fw-normal text-secondary">D√≠as solicitados</dt>
                <dd class="col-sm-8"><%= so.getDiasSolicitados() %></dd>
                <% if (so.getFechaResolucion() != null) { %>
                <dt class="col-sm-4 fw-normal text-secondary">Resuelta por</dt>
                <dd class="col-sm-8"><%= Html.esc(so.getAprobadorNombre()) %> ¬∑ <%= so.getFechaResolucion().toLocalDate() %></dd>
                <% } %>
                <dt class="col-sm-4 fw-normal text-secondary">Observaciones</dt>
                <dd class="col-sm-8 mb-0"><%= so.getObservaciones().isEmpty() ? "‚Äî" : Html.esc(so.getObservaciones()) %></dd>
            </dl>
        </section>

        <section class="card p-4">
            <h2 class="h5 fw-bold mb-3">Equipos solicitados</h2>
            <div class="table-responsive">
                <table class="table tabla align-middle mb-0">
                    <thead><tr><th>C√≥digo</th><th>Equipo</th><th>Estado actual</th><th>D√≠as</th><th>Precio por d√≠a</th><th class="text-end">Subtotal</th></tr></thead>
                    <tbody>
                    <% for (DetalleSolicitud d : so.getDetalles()) {
                           boolean libre = "DISPONIBLE".equals(d.getEquipoEstado());
                    %>
                        <tr>
                            <td class="fw-semibold"><%= Html.esc(d.getEquipoCodigo()) %></td>
                            <td><%= Html.esc(d.getEquipoNombre()) %></td>
                            <td><span class="badge <%= libre ? "text-bg-success" : "text-bg-warning" %>"><%= Html.esc(EquipoService.etiquetaEstado(d.getEquipoEstado())) %></span></td>
                            <td><%= d.getDias() %></td>
                            <td class="text-nowrap">S/ <%= d.getPrecioDia().toPlainString() %></td>
                            <td class="text-end text-nowrap">S/ <%= d.getSubtotal().toPlainString() %></td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
            <% if (aprobada) { %>
            <p class="text-secondary small mt-3 mb-0">Al convertirla, el alquiler se calcula con los precios vigentes ese d√≠a y los equipos deben seguir disponibles.</p>
            <% } %>
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="card p-4 mb-3">
            <h2 class="h5 fw-bold mb-3">Montos estimados</h2>
            <dl class="row mb-0">
                <dt class="col-6 fw-normal text-secondary">Subtotal</dt><dd class="col-6 text-end">S/ <%= so.getSubtotal().toPlainString() %></dd>
                <dt class="col-6 fw-normal text-secondary">IGV</dt><dd class="col-6 text-end">S/ <%= so.getIgv().toPlainString() %></dd>
                <dt class="col-6">Total</dt><dd class="col-6 text-end fw-bold">S/ <%= so.getTotal().toPlainString() %></dd>
                <dt class="col-6 fw-normal text-secondary">Garant√≠a</dt><dd class="col-6 text-end">S/ <%= so.getGarantia().toPlainString() %></dd>
            </dl>
        </section>

        <% if (esAdmin && (pendiente || aprobada)) { %>
        <section class="card p-4">
            <h2 class="h6 fw-bold mb-2">Anular solicitud</h2>
            <p class="text-secondary small">La solicitud deja de ser v√°lida y no se podr√° convertir en alquiler.</p>
            <form method="post" action="<%= ctx %>/solicitudes"
                  onsubmit="return confirm('¬øAnular la solicitud N.¬∫ <%= so.getId() %>? Esta acci√≥n no se puede deshacer.');">
                <input type="hidden" name="accion" value="anular">
                <input type="hidden" name="id" value="<%= so.getId() %>">
                <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
                <button type="submit" class="btn btn-outline-danger btn-sm">Anular solicitud</button>
            </form>
        </section>
        <% } %>
    </div>
</div>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]ú_3©¨!  ¨!  !   WEB-INF/vistas/solicitud-form.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.util.List"%>
<%@page import="java.util.Set"%>
<%@page import="com.rentatools.model.Cliente"%>
<%@page import="com.rentatools.model.Equipo"%>
<%@page import="com.rentatools.service.AlquilerService"%>
<% String tituloPagina = "Solicitud de alquiler"; String menuActivo = "solicitudes"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    boolean editar = "editar".equals(request.getAttribute("modo"));
    int solicitudId = (Integer) request.getAttribute("solicitudId");
    @SuppressWarnings("unchecked")
    List<Cliente> clientes = (List<Cliente>) request.getAttribute("clientes");
    @SuppressWarnings("unchecked")
    List<Equipo> equipos = (List<Equipo>) request.getAttribute("equipos");
    @SuppressWarnings("unchecked")
    List<String> errores = (List<String>) request.getAttribute("errores");
    @SuppressWarnings("unchecked")
    Set<Integer> marcados = (Set<Integer>) request.getAttribute("formEquipoIds");
    int formClienteId = (Integer) request.getAttribute("formClienteId");
    String formDias = (String) request.getAttribute("formDias");
    String formObs = (String) request.getAttribute("formObservaciones");
    String csrf = (String) request.getAttribute("csrf");
%>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1"><%= editar ? "Editar solicitud N.¬∫ " + solicitudId : "Nueva solicitud de alquiler" %></h1>
    <p class="text-secondary mb-0">Los montos son estimados. Los equipos se reservan reci√©n cuando la solicitud se convierte en alquiler.</p>
</div>

<% if (errores != null && !errores.isEmpty()) { %>
<div class="alert alert-danger" role="alert">
    <ul class="mb-0"><% for (String err : errores) { %><li><%= Html.esc(err) %></li><% } %></ul>
</div>
<% } %>

<form method="post" action="<%= ctx %>/solicitudes" novalidate>
    <input type="hidden" name="accion" value="<%= editar ? "actualizar" : "crear" %>">
    <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
    <% if (editar) { %><input type="hidden" name="id" value="<%= solicitudId %>"><% } %>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <section class="card p-4 mb-3">
                <h2 class="h5 fw-bold mb-3">Cliente y plazo</h2>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label for="clienteId" class="form-label fw-semibold">Cliente *</label>
                        <select id="clienteId" name="clienteId" class="form-select">
                            <option value="">Seleccione‚Ä¶</option>
                            <% for (Cliente c : clientes) { %>
                            <option value="<%= c.getId() %>" <%= c.getId() == formClienteId ? "selected" : "" %>>
                                <%= Html.esc((c.getNombres() + " " + c.getApellidos()).trim()) %> ¬∑ <%= Html.esc(c.getTipoDocumento()) %> <%= Html.esc(c.getNumeroDocumento()) %>
                            </option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="dias" class="form-label fw-semibold">D√≠as de alquiler *</label>
                        <input type="number" id="dias" name="dias" class="form-control" min="1" max="<%= AlquilerService.DIAS_MAXIMO %>"
                               value="<%= Html.esc(formDias) %>">
                    </div>
                    <div class="col-12">
                        <label for="observaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea id="observaciones" name="observaciones" class="form-control" rows="2"
                                  maxlength="255"><%= Html.esc(formObs) %></textarea>
                    </div>
                </div>
            </section>

            <section class="card p-4">
                <h2 class="h5 fw-bold mb-3">Equipos solicitados</h2>
                <% if (equipos.isEmpty()) { %>
                <p class="text-secondary mb-0">No hay equipos disponibles en este momento.</p>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table tabla align-middle mb-0">
                        <thead><tr><th style="width: 40px"></th><th>C√≥digo</th><th>Equipo</th><th>Categor√≠a</th><th>Precio por d√≠a</th></tr></thead>
                        <tbody>
                        <% for (Equipo eq : equipos) { %>
                            <tr>
                                <td><input type="checkbox" class="form-check-input chk-equipo" name="equipoId"
                                           value="<%= eq.getId() %>" data-precio="<%= eq.getPrecioDia().toPlainString() %>"
                                           id="eq<%= eq.getId() %>" aria-label="Seleccionar <%= Html.esc(eq.getCodigo()) %>"
                                           <%= marcados != null && marcados.contains(eq.getId()) ? "checked" : "" %>></td>
                                <td class="fw-semibold"><label for="eq<%= eq.getId() %>"><%= Html.esc(eq.getCodigo()) %></label></td>
                                <td><%= Html.esc(eq.getNombre()) %>
                                    <% if (!eq.getMarca().isEmpty()) { %><span class="text-secondary small">¬∑ <%= Html.esc(eq.getMarca()) %></span><% } %></td>
                                <td><%= Html.esc(eq.getCategoria()) %></td>
                                <td class="text-nowrap">S/ <%= eq.getPrecioDia().toPlainString() %></td>
                            </tr>
                        <% } %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="card p-4" id="resumen"
                     data-igv="<%= AlquilerService.IGV.toPlainString() %>"
                     data-garantia="<%= AlquilerService.GARANTIA.toPlainString() %>">
                <h2 class="h5 fw-bold mb-3">Resumen estimado</h2>
                <dl class="row mb-0">
                    <dt class="col-7 fw-normal text-secondary">Equipos</dt><dd class="col-5 text-end" id="rEquipos">0</dd>
                    <dt class="col-7 fw-normal text-secondary">D√≠as</dt><dd class="col-5 text-end" id="rDias">0</dd>
                    <dt class="col-7 fw-normal text-secondary">Subtotal</dt><dd class="col-5 text-end" id="rSubtotal">S/ 0.00</dd>
                    <dt class="col-7 fw-normal text-secondary">IGV</dt><dd class="col-5 text-end" id="rIgv">S/ 0.00</dd>
                    <dt class="col-7">Total</dt><dd class="col-5 text-end fw-bold" id="rTotal">S/ 0.00</dd>
                    <dt class="col-7 fw-normal text-secondary">Garant√≠a</dt><dd class="col-5 text-end" id="rGarantia">S/ 0.00</dd>
                </dl>
                <button type="submit" class="btn btn-naranja w-100 mt-3"><%= editar ? "Guardar cambios" : "Registrar solicitud" %></button>
                <a class="btn btn-outline-primary w-100 mt-2"
                   href="<%= ctx %>/solicitudes<%= editar ? "?accion=ver&amp;id=" + solicitudId : "" %>">Cancelar</a>
            </section>
        </div>
    </div>
</form>

<script>
    (function () {
        var panel = document.getElementById('resumen');
        var igv = parseFloat(panel.dataset.igv);
        var garantia = parseFloat(panel.dataset.garantia);
        function soles(n) { return 'S/ ' + n.toFixed(2); }

        function recalcular() {
            var dias = Math.max(0, parseInt(document.getElementById('dias').value, 10) || 0);
            var marcados = document.querySelectorAll('.chk-equipo:checked');
            var subtotal = 0;
            marcados.forEach(function (c) { subtotal += parseFloat(c.dataset.precio) * dias; });
            document.getElementById('rEquipos').textContent = marcados.length;
            document.getElementById('rDias').textContent = dias;
            document.getElementById('rSubtotal').textContent = soles(subtotal);
            document.getElementById('rIgv').textContent = soles(subtotal * igv);
            document.getElementById('rTotal').textContent = soles(subtotal * (1 + igv));
            document.getElementById('rGarantia').textContent = soles(subtotal * garantia);
        }

        document.getElementById('dias').addEventListener('input', recalcular);
        document.querySelectorAll('.chk-equipo').forEach(function (c) { c.addEventListener('change', recalcular); });
        recalcular();
    })();
</script>

