    oÇ{]˚¯˜SS(  S(  #   WEB-INF/vistas/alquiler-detalle.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.time.LocalDate"%>
<%@page import="com.rentatools.model.Alquiler"%>
<%@page import="com.rentatools.model.DetalleAlquiler"%>
<%@page import="com.rentatools.model.Comprobante"%>
<%@page import="com.rentatools.model.Devolucion"%>
<%@page import="com.rentatools.model.GuiaEntrega"%>
<%@page import="com.rentatools.service.ComprobanteService"%>
<%@page import="com.rentatools.service.GuiaService"%>
<%@page import="com.rentatools.service.AlquilerService"%>
<% String tituloPagina = "Alquiler"; String menuActivo = "alquileres"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    Alquiler al = (Alquiler) request.getAttribute("alquiler");
    Devolucion devolucion = (Devolucion) request.getAttribute("devolucion");
    Comprobante comprobante = (Comprobante) request.getAttribute("comprobante");
    GuiaEntrega guia = (GuiaEntrega) request.getAttribute("guia");
    boolean alquilerAnulado = "ANULADO".equals(al.getEstado());
    LocalDate hoy = (LocalDate) request.getAttribute("hoy");
    String csrf = (String) request.getAttribute("csrf");
    String flashTipo = (String) request.getAttribute("flashTipo");
    String flashMensaje = (String) request.getAttribute("flashMensaje");
    String st = al.getEstado();
    boolean activo = "ACTIVO".equals(st);
    String claseEstado = activo ? "text-bg-primary" : "FINALIZADO".equals(st) ? "text-bg-success" : "text-bg-secondary";
    String etiquetaEstado = activo ? "Activo" : "FINALIZADO".equals(st) ? "Finalizado" : "Anulado";
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Alquiler N.¬∫ <%= al.getId() %>
            <span class="badge fs-6 align-middle <%= claseEstado %>"><%= etiquetaEstado %></span></h1>
        <p class="text-secondary mb-0">Registrado por <%= Html.esc(al.getUsuarioNombre()) %></p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="<%= ctx %>/alquileres">Volver a la lista</a>
        <% if (activo) { %>
        <a class="btn btn-naranja" href="<%= ctx %>/devoluciones?accion=nueva&amp;alquilerId=<%= al.getId() %>">Registrar devoluci√≥n</a>
        <% } %>
        <% if (devolucion != null) { %>
        <a class="btn btn-outline-primary" href="<%= ctx %>/devoluciones?accion=ver&amp;id=<%= devolucion.getId() %>">Ver devoluci√≥n</a>
        <% } %>
        <% if (esAdmin && activo) { %>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalAnular">Anular alquiler</button>
        <% } %>
    </div>
</div>

<% if (flashMensaje != null) { %>
<div class="alert alert-<%= Html.esc(flashTipo) %> alert-dismissible fade show" role="alert">
    <%= Html.esc(flashMensaje) %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <section class="card p-4 mb-3">
            <h2 class="h5 fw-bold mb-3">Datos del alquiler</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-normal text-secondary">Cliente</dt>
                <dd class="col-sm-8"><%= Html.esc(al.getClienteNombre()) %> ¬∑ <%= Html.esc(al.getClienteDocumento()) %></dd>
                <% if (al.getSolicitudId() > 0) { %>
                <dt class="col-sm-4 fw-normal text-secondary">Solicitud de origen</dt>
                <dd class="col-sm-8"><a href="<%= ctx %>/solicitudes?accion=ver&amp;id=<%= al.getSolicitudId() %>">N.¬∫ <%= al.getSolicitudId() %></a></dd>
                <% } %>
                <dt class="col-sm-4 fw-normal text-secondary">Fecha de inicio</dt>
                <dd class="col-sm-8"><%= al.getFechaInicio() %></dd>
                <dt class="col-sm-4 fw-normal text-secondary">Devoluci√≥n prevista</dt>
                <dd class="col-sm-8"><%= al.getFechaDevolucionPrevista() %>
                    <% if (activo) { %><span class="badge ms-2 <%= AlquilerService.clasePlazo(al, hoy) %>"><%= Html.esc(AlquilerService.etiquetaPlazo(al, hoy)) %></span><% } %></dd>
                <% if (al.getFechaDevolucionReal() != null) { %>
                <dt class="col-sm-4 fw-normal text-secondary">Devoluci√≥n real</dt>
                <dd class="col-sm-8"><%= al.getFechaDevolucionReal() %></dd>
                <% } %>
                <dt class="col-sm-4 fw-normal text-secondary">Observaciones</dt>
                <dd class="col-sm-8 mb-0"><%= al.getObservaciones().isEmpty() ? "‚Äî" : Html.esc(al.getObservaciones()) %></dd>
            </dl>
        </section>

        <section class="card p-4">
            <h2 class="h5 fw-bold mb-3">Equipos</h2>
            <div class="table-responsive">
                <table class="table tabla align-middle mb-0">
                    <thead><tr><th>C√≥digo</th><th>Equipo</th><th>D√≠as</th><th>Precio por d√≠a</th><th class="text-end">Subtotal</th></tr></thead>
                    <tbody>
                    <% for (DetalleAlquiler d : al.getDetalles()) { %>
                        <tr>
                            <td class="fw-semibold"><%= Html.esc(d.getEquipoCodigo()) %></td>
                            <td><%= Html.esc(d.getEquipoNombre()) %></td>
                            <td><%= d.getDias() %></td>
                            <td class="text-nowrap">S/ <%= d.getPrecioDia().toPlainString() %></td>
                            <td class="text-end text-nowrap">S/ <%= d.getSubtotal().toPlainString() %></td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="card p-4 mb-3">
            <h2 class="h5 fw-bold mb-3">Documentos</h2>

            <div class="mb-3">
                <div class="text-secondary small mb-1">Comprobante de pago</div>
                <% if (comprobante != null) { %>
                <a class="fw-semibold text-decoration-none" href="<%= ctx %>/comprobantes?accion=ver&amp;id=<%= comprobante.getId() %>"><%= comprobante.getNumeroCompleto() %></a>
                <span class="badge text-bg-light border"><%= Html.esc(ComprobanteService.etiquetaTipo(comprobante.getTipo())) %></span>
                <% if ("ANULADO".equals(comprobante.getEstado())) { %><span class="badge text-bg-secondary">Anulado</span><% } %>
                <% } else if (!alquilerAnulado) { %>
                <div class="small text-warning-emphasis mb-2">Pendiente de emitir.</div>
                <form method="post" action="<%= ctx %>/comprobantes">
                    <input type="hidden" name="accion" value="emitir">
                    <input type="hidden" name="alquilerId" value="<%= al.getId() %>">
                    <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Emitir comprobante</button>
                </form>
                <% } else { %><span class="text-secondary">‚Äî</span><% } %>
            </div>

            <div>
                <div class="text-secondary small mb-1">Gu√≠a de entrega</div>
                <% if (guia != null) { %>
                <a class="fw-semibold text-decoration-none" href="<%= ctx %>/guias?accion=ver&amp;id=<%= guia.getId() %>"><%= guia.getNumeroCompleto() %></a>
                <span class="badge <%= GuiaService.claseEstado(guia.getEstado()) %>"><%= Html.esc(GuiaService.etiquetaEstado(guia.getEstado())) %></span>
                <% } else if (!alquilerAnulado) { %>
                <div class="small text-warning-emphasis mb-2">Pendiente de emitir.</div>
                <form method="post" action="<%= ctx %>/guias">
                    <input type="hidden" name="accion" value="emitir">
                    <input type="hidden" name="alquilerId" value="<%= al.getId() %>">
                    <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Emitir gu√≠a de entrega</button>
                </form>
                <% } else { %><span class="text-secondary">‚Äî</span><% } %>
            </div>
        </section>

        <section class="card p-4">
            <h2 class="h5 fw-bold mb-3">Montos</h2>
            <dl class="row mb-0">
                <dt class="col-6 fw-normal text-secondary">Subtotal</dt><dd class="col-6 text-end">S/ <%= al.getSubtotal().toPlainString() %></dd>
                <dt class="col-6 fw-normal text-secondary">IGV</dt><dd class="col-6 text-end">S/ <%= al.getIgv().toPlainString() %></dd>
                <dt class="col-6">Total</dt><dd class="col-6 text-end fw-bold">S/ <%= al.getTotal().toPlainString() %></dd>
                <dt class="col-6 fw-normal text-secondary">Garant√≠a (reembolsable)</dt><dd class="col-6 text-end">S/ <%= al.getGarantia().toPlainString() %></dd>
            </dl>
        </section>
    </div>
</div>

<% if (esAdmin && activo) { %>
<div class="modal fade" id="modalAnular" tabindex="-1" aria-labelledby="tituloAnular" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" action="<%= ctx %>/alquileres" class="modal-content">
            <input type="hidden" name="accion" value="anular">
            <input type="hidden" name="id" value="<%= al.getId() %>">
            <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
            <div class="modal-header">
                <h2 class="modal-title h5" id="tituloAnular">Anular alquiler</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¬øSeguro que desea anular el alquiler N.¬∫ <strong><%= al.getId() %></strong>?
                Los equipos volver√°n a estar disponibles. Esta acci√≥n no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Anular</button>
            </div>
        </form>
    </div>
</div>
<% } %>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]Ç¯My$  y$      WEB-INF/vistas/alquiler-form.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.time.LocalDate"%>
<%@page import="java.util.List"%>
<%@page import="java.util.Set"%>
<%@page import="com.rentatools.model.Cliente"%>
<%@page import="com.rentatools.model.Equipo"%>
<%@page import="com.rentatools.service.AlquilerService"%>
<% String tituloPagina = "Nuevo alquiler"; String menuActivo = "alquileres"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    @SuppressWarnings("unchecked")
    List<Cliente> clientes = (List<Cliente>) request.getAttribute("clientes");
    @SuppressWarnings("unchecked")
    List<Equipo> equipos = (List<Equipo>) request.getAttribute("equipos");
    @SuppressWarnings("unchecked")
    List<String> errores = (List<String>) request.getAttribute("errores");
    @SuppressWarnings("unchecked")
    Set<Integer> marcados = (Set<Integer>) request.getAttribute("formEquipoIds");
    int formClienteId = (Integer) request.getAttribute("formClienteId");
    String formFecha = (String) request.getAttribute("formFecha");
    String formObs = (String) request.getAttribute("formObservaciones");
    LocalDate hoy = (LocalDate) request.getAttribute("hoy");
    String csrf = (String) request.getAttribute("csrf");
%>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Nuevo alquiler</h1>
    <p class="text-secondary mb-0">El alquiler inicia hoy (<%= hoy %>). Los equipos elegidos quedan como alquilados.</p>
</div>

<% if (errores != null && !errores.isEmpty()) { %>
<div class="alert alert-danger" role="alert">
    <ul class="mb-0">
        <% for (String err : errores) { %><li><%= Html.esc(err) %></li><% } %>
    </ul>
</div>
<% } %>

<form method="post" action="<%= ctx %>/alquileres" novalidate>
    <input type="hidden" name="accion" value="registrar">
    <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <section class="card p-4 mb-3">
                <h2 class="h5 fw-bold mb-3">Cliente y plazo</h2>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label for="clienteId" class="form-label fw-semibold">Cliente *</label>
                        <select id="clienteId" name="clienteId" class="form-select">
                            <option value="">Seleccione‚Ä¶</option>
                            <% for (Cliente c : clientes) { %>
                            <option value="<%= c.getId() %>" <%= c.getId() == formClienteId ? "selected" : "" %>>
                                <%= Html.esc((c.getNombres() + " " + c.getApellidos()).trim()) %> ¬∑ <%= Html.esc(c.getTipoDocumento()) %> <%= Html.esc(c.getNumeroDocumento()) %>
                            </option>
                            <% } %>
                        </select>
                        <% if (clientes.isEmpty()) { %>
                        <div class="form-text text-danger">No hay clientes activos. Registre uno primero.</div>
                        <% } %>
                    </div>
                    <div class="col-md-5">
                        <label for="fecha" class="form-label fw-semibold">Fecha de devoluci√≥n *</label>
                        <input type="date" id="fecha" name="fechaDevolucion" class="form-control"
                               min="<%= hoy %>" value="<%= Html.esc(formFecha) %>">
                    </div>
                    <div class="col-12">
                        <label for="observaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea id="observaciones" name="observaciones" class="form-control" rows="2"
                                  maxlength="255"><%= Html.esc(formObs) %></textarea>
                    </div>
                </div>
            </section>

            <section class="card p-4">
                <h2 class="h5 fw-bold mb-3">Equipos disponibles</h2>
                <% if (equipos.isEmpty()) { %>
                <p class="text-secondary mb-0">No hay equipos disponibles en este momento.</p>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table tabla align-middle mb-0">
                        <thead>
                            <tr><th style="width: 40px"></th><th>C√≥digo</th><th>Equipo</th><th>Categor√≠a</th><th>Precio por d√≠a</th></tr>
                        </thead>
                        <tbody>
                        <% for (Equipo eq : equipos) { %>
                            <tr>
                                <td><input type="checkbox" class="form-check-input chk-equipo" name="equipoId"
                                           value="<%= eq.getId() %>" data-precio="<%= eq.getPrecioDia().toPlainString() %>"
                                           id="eq<%= eq.getId() %>" aria-label="Seleccionar <%= Html.esc(eq.getCodigo()) %>"
                                           <%= marcados != null && marcados.contains(eq.getId()) ? "checked" : "" %>></td>
                                <td class="fw-semibold"><label for="eq<%= eq.getId() %>"><%= Html.esc(eq.getCodigo()) %></label></td>
                                <td><%= Html.esc(eq.getNombre()) %>
                                    <% if (!eq.getMarca().isEmpty()) { %><span class="text-secondary small">¬∑ <%= Html.esc(eq.getMarca()) %></span><% } %></td>
                                <td><%= Html.esc(eq.getCategoria()) %></td>
                                <td class="text-nowrap">S/ <%= eq.getPrecioDia().toPlainString() %></td>
                            </tr>
                        <% } %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="card p-4" id="resumen"
                     data-hoy="<%= hoy %>" data-igv="<%= AlquilerService.IGV.toPlainString() %>"
                     data-garantia="<%= AlquilerService.GARANTIA.toPlainString() %>">
                <h2 class="h5 fw-bold mb-3">Resumen estimado</h2>
                <dl class="row mb-0">
                    <dt class="col-7 fw-normal text-secondary">Equipos</dt><dd class="col-5 text-end" id="rEquipos">0</dd>
                    <dt class="col-7 fw-normal text-secondary">D√≠as</dt><dd class="col-5 text-end" id="rDias">0</dd>
                    <dt class="col-7 fw-normal text-secondary">Subtotal</dt><dd class="col-5 text-end" id="rSubtotal">S/ 0.00</dd>
                    <dt class="col-7 fw-normal text-secondary">IGV (<%= AlquilerService.IGV.movePointRight(2).stripTrailingZeros().toPlainString() %> %)</dt><dd class="col-5 text-end" id="rIgv">S/ 0.00</dd>
                    <dt class="col-7">Total del alquiler</dt><dd class="col-5 text-end fw-bold" id="rTotal">S/ 0.00</dd>
                    <dt class="col-7 fw-normal text-secondary">Garant√≠a (<%= AlquilerService.GARANTIA.movePointRight(2).stripTrailingZeros().toPlainString() %> %, reembolsable)</dt><dd class="col-5 text-end" id="rGarantia">S/ 0.00</dd>
                    <dt class="col-7">A cobrar al entregar</dt><dd class="col-5 text-end fw-bold" id="rCobrar">S/ 0.00</dd>
                </dl>
                <p class="text-secondary small mt-3 mb-0">Valores estimados: el sistema calcula los montos definitivos al registrar.</p>
                <button type="submit" class="btn btn-naranja w-100 mt-3">Registrar alquiler</button>
                <a class="btn btn-outline-primary w-100 mt-2" href="<%= ctx %>/alquileres">Cancelar</a>
            </section>
        </div>
    </div>
</form>

<script>
    (function () {
        var panel = document.getElementById('resumen');
        var hoy = new Date(panel.dataset.hoy + 'T00:00:00');
        var igv = parseFloat(panel.dataset.igv);
        var garantia = parseFloat(panel.dataset.garantia);

        function soles(n) { return 'S/ ' + n.toFixed(2); }

        function recalcular() {
            var f = document.getElementById('fecha').value;
            var dias = 0;
            if (f) {
                var d = new Date(f + 'T00:00:00');
                dias = Math.max(1, Math.round((d - hoy) / 86400000));
            }
            var marcados = document.querySelectorAll('.chk-equipo:checked');
            var subtotal = 0;
            marcados.forEach(function (c) { subtotal += parseFloat(c.dataset.precio) * dias; });
            var iva = subtotal * igv;
            var gar = subtotal * garantia;
            document.getElementById('rEquipos').textContent = marcados.length;
            document.getElementById('rDias').textContent = dias;
            document.getElementById('rSubtotal').textContent = soles(subtotal);
            document.getElementById('rIgv').textContent = soles(iva);
            document.getElementById('rTotal').textContent = soles(subtotal + iva);
            document.getElementById('rGarantia').textContent = soles(gar);
            document.getElementById('rCobrar').textContent = soles(subtotal + iva + gar);
        }

        document.getElementById('fecha').addEventListener('change', recalcular);
        document.querySelectorAll('.chk-equipo').forEach(function (c) { c.addEventListener('change', recalcular); });
        recalcular();
    })();
</script>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]ˇ—˚+  +     WEB-INF/vistas/alquileres.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.time.LocalDate"%>
<%@page import="java.util.List"%>
<%@page import="com.rentatools.model.Alquiler"%>
<%@page import="com.rentatools.service.AlquilerService"%>
<% String tituloPagina = "Alquileres"; String menuActivo = "alquileres"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    @SuppressWarnings("unchecked")
    List<Alquiler> alquileres = (List<Alquiler>) request.getAttribute("alquileres");
    LocalDate hoy = (LocalDate) request.getAttribute("hoy");
    String flashTipo = (String) request.getAttribute("flashTipo");
    String flashMensaje = (String) request.getAttribute("flashMensaje");
    String busqueda = ((com.rentatools.model.Pagina<?>) request.getAttribute("pag")).getQ();
    int activos = (Integer) request.getAttribute("kActivos");
    int porVencer = (Integer) request.getAttribute("kPorVencer");
    int vencidos = (Integer) request.getAttribute("kVencidos");
    int finalizados = (Integer) request.getAttribute("kFinalizados");
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Alquileres</h1>
        <p class="text-secondary mb-0">Registro y seguimiento de los alquileres de equipos.</p>
    </div>
    <a class="btn btn-naranja px-4 py-2" href="<%= ctx %>/alquileres?accion=nuevo">+ Nuevo alquiler</a>
</div>

<% if (flashMensaje != null) { %>
<div class="alert alert-<%= Html.esc(flashTipo) %> alert-dismissible fade show" role="alert">
    <%= Html.esc(flashMensaje) %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
</div>
<% } %>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi p-3"><div class="titulo">Activos</div><div class="valor"><%= activos %></div></div></div>
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi naranja p-3"><div class="titulo">Por vencer</div><div class="valor"><%= porVencer %></div></div></div>
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi p-3" style="border-top-color: #a32a12"><div class="titulo">Vencidos</div><div class="valor"><%= vencidos %></div></div></div>
    <div class="col-12 col-md-6 col-xl-3"><div class="card kpi verde p-3"><div class="titulo">Finalizados</div><div class="valor"><%= finalizados %></div></div></div>
</div>

<section class="card p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h2 class="h5 fw-bold mb-0">Lista de alquileres</h2>
        <form method="get" action="<%= ctx %>/alquileres" class="d-flex gap-2">
            <input type="text" name="q" value="<%= Html.esc(busqueda) %>" class="form-control" style="max-width: 280px"
                   placeholder="Buscar alquiler‚Ä¶" aria-label="Buscar alquiler">
            <button class="btn btn-outline-primary" type="submit">Buscar</button>
            <% if (!busqueda.isEmpty()) { %><a class="btn btn-link" href="<%= ctx %>/alquileres">Limpiar</a><% } %>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table tabla align-middle" id="tablaAlquileres">
            <thead>
                <tr>
                    <th>N.¬∫</th><th>Cliente</th><th>Equipos</th><th>Inicio</th><th>Devoluci√≥n prevista</th>
                    <th>Total</th><th>Estado</th><th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            <% for (Alquiler al : alquileres) {
                   String st = al.getEstado();
                   boolean activo = "ACTIVO".equals(st);
                   String claseEstado = activo ? "text-bg-primary" : "FINALIZADO".equals(st) ? "text-bg-success" : "text-bg-secondary";
                   String etiquetaEstado = activo ? "Activo" : "FINALIZADO".equals(st) ? "Finalizado" : "Anulado";
            %>
                <tr>
                    <td class="fw-semibold"><%= al.getId() %></td>
                    <td><%= Html.esc(al.getClienteNombre()) %>
                        <div class="text-secondary small"><%= Html.esc(al.getClienteDocumento()) %></div></td>
                    <td><%= al.getCantidadEquipos() %></td>
                    <td class="text-nowrap"><%= al.getFechaInicio() %></td>
                    <td class="text-nowrap"><%= al.getFechaDevolucionPrevista() %>
                        <% if (activo) { %><div><span class="badge <%= AlquilerService.clasePlazo(al, hoy) %>"><%= Html.esc(AlquilerService.etiquetaPlazo(al, hoy)) %></span></div><% } %></td>
                    <td class="text-nowrap">S/ <%= al.getTotal().toPlainString() %></td>
                    <td><span class="badge <%= claseEstado %>"><%= etiquetaEstado %></span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary"
                           href="<%= ctx %>/alquileres?accion=ver&amp;id=<%= al.getId() %>">Ver</a>
                    </td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <% if (alquileres.isEmpty()) { %><p class="text-secondary mb-0"><%= busqueda.isEmpty() ? "A√∫n no hay alquileres registrados." : "No se encontraron resultados para la b√∫squeda." %></p><% } %>
    <%@ include file="fragmentos/paginacion.jspf" %>
</section>

<script>
</script>

<%@ include file="fragmentos/pie.jspf" %>
PK
    oÇ{]Ä’æÀà  à     WEB-INF/vistas/cliente-form.jsp<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.util.List"%>
<%@page import="com.rentatools.model.Cliente"%>
<% String tituloPagina = "Cliente"; String menuActivo = "clientes"; %>
<%@ include file="fragmentos/cabecera.jspf" %>
<%
    Cliente f = (Cliente) request.getAttribute("clienteForm");
    boolean editar = "editar".equals(request.getAttribute("modo"));
    @SuppressWarnings("unchecked")
    List<String> errores = (List<String>) request.getAttribute("errores");
    String csrf = (String) request.getAttribute("csrf");
%>

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1"><%= editar ? "Editar cliente" : "Nuevo cliente" %></h1>
    <p class="text-secondary mb-0">Los campos con * son obligatorios.</p>
</div>

<% if (errores != null && !errores.isEmpty()) { %>
<div class="alert alert-danger" role="alert">
    <ul class="mb-0">
        <% for (String err : errores) { %><li><%= Html.esc(err) %></li><% } %>
    </ul>
</div>
<% } %>

<form method="post" action="<%= ctx %>/clientes" class="card p-4" novalidate>
    <input type="hidden" name="accion" value="<%= editar ? "actualizar" : "crear" %>">
    <input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>">
    <% if (editar) { %><input type="hidden" name="id" value="<%= f.getId() %>"><% } %>

    <div class="row g-3">
        <div class="col-md-4">
            <label for="tipoDocumento" class="form-label fw-semibold">Tipo de documento *</label>
            <select id="tipoDocumento" name="tipoDocumento" class="form-select">
                <option value="DNI" <%= "DNI".equals(f.getTipoDocumento()) ? "selected" : "" %>>DNI</option>
                <option value="RUC" <%= "RUC".equals(f.getTipoDocumento()) ? "selected" : "" %>>RUC</option>
                <option value="CE" <%= "CE".equals(f.getTipoDocumento()) ? "selected" : "" %>>Carnet de extranjer√≠a</option>
            </select>
        </div>
        <div class="col-md-8">
            <label for="numeroDocumento" class="form-label fw-semibold">N√∫mero de documento *</label>
            <input type="text" id="numeroDocumento" name="numeroDocumento" class="form-control"
                   maxlength="15" autocomplete="off" required
                   value="<%= Html.esc(f.getNumeroDocumento()) %>">
            <div class="form-text">DNI: 8 d√≠gitos ¬∑ RUC: 11 d√≠gitos ¬∑ Carnet: 9 a 12 letras o n√∫meros.</div>
        </div>
        <div class="col-md-6">
            <label for="nombres" class="form-label fw-semibold">Nombres o raz√≥n social *</label>
            <input type="text" id="nombres" name="nombres" class="form-control" maxlength="100" required
                   value="<%= Html.esc(f.getNombres()) %>">
        </div>
        <div class="col-md-6">
            <label for="apellidos" class="form-label fw-semibold">Apellidos</label>
            <input type="text" id="apellidos" name="apellidos" class="form-control" maxlength="100"
                   value="<%= Html.esc(f.getApellidos()) %>">
            <div class="form-text">Obligatorio para DNI y carnet. D√©jelo vac√≠o si es una empresa (RUC).</div>
        </div>
        <div class="col-md-6">
            <label for="telefono" class="form-label fw-semibold">Tel√©fono</label>
            <input type="text" id="telefono" name="telefono" class="form-control" maxlength="20"
                   value="<%= Html.esc(f.getTelefono()) %>">
        </div>
        <div class="col-md-6">
            <label for="correo" class="form-label fw-semibold">Correo electr√≥nico</label>
            <input type="email" id="correo" name="correo" class="form-control" maxlength="120"
                   value="<%= Html.esc(f.getCorreo()) %>">
        </div>
        <div class="col-md-8">
            <label for="direccion" class="form-label fw-semibold">Direcci√≥n</label>
            <input type="text" id="direccion" name="direccion" class="form-control" maxlength="200"
                   value="<%= Html.esc(f.getDireccion()) %>">
        </div>
        <div class="col-md-4">
            <label for="estado" class="form-label fw-semibold">Estado *</label>
            <select id="estado" name="estado" class="form-select">
                <option value="ACTIVO" <%= "ACTIVO".equals(f.getEstado()) ? "selected" : "" %>>Activo</option>
                <option value="INACTIVO" <%= "INACTIVO".equals(f.getEstado()) ? "selected" : "" %>>Inactivo</option>
            </select>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-naranja px-4"><%= editar ? "Guardar cambios" : "Registrar cliente" %></button>
        <a class="btn btn-outline-primary" href="<%= ctx %>/clientes">Cancelar</a>
    </div>
</form>

